{
  "name": "@x-oidc/applications",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @x-oidc/contracts build && pnpm --filter @x-oidc/application-templates build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @x-oidc/contracts build && pnpm --filter @x-oidc/application-templates build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @x-oidc/contracts build && pnpm --filter @x-oidc/application-templates build",
    "test": "vitest run"
  },
  "dependencies": {
    "@x-oidc/application-templates": "workspace:*",
    "@x-oidc/contracts": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^24.22.1"
  }
}
