{
  "name": "@gitea-oidc/express",
  "version": "0.0.0",
  "description": "Express 4 and 5 connector for Gitea OIDC",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "prebuild": "pnpm --filter @gitea-oidc/connector-core build",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @gitea-oidc/connector-core build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @gitea-oidc/connector-testkit build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "@gitea-oidc/connector-core": "workspace:*",
    "@gitea-oidc/node": "workspace:*"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@gitea-oidc/connector-testkit": "workspace:*",
    "@types/express": "^5.0.5",
    "@types/node": "^22.0.0",
    "express": "^5.2.1",
    "express4": "npm:express@4.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
